# Local configuration reference only. No credentials belong in this file.
# This app does NOT automatically load .env files.
# Set overrides in the API terminal; otherwise built-in defaults work.
# MFI_DB_PATH=<absolute-path-to-local-sqlite-file>
# MFI_API_PORT=<local-api-port>
# MFI_WEB_ORIGIN=<exact-local-frontend-origin>
# MFI_DEMO_PASSWORD=<choose-a-local-test-password-12-to-128-characters>
# Prefer the hidden password prompt when seeding; no password is needed at runtime.
# Never expose secrets through VITE_* variables.
